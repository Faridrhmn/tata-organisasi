# ========================================================
# TARI (Tata Organisasi) — Environment Configuration Template
# ========================================================

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=1999
ENVIRONMENT=production

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgres://postgres:password_kamu@localhost:5432/tari_db
DATABASE_MAX_CONNECTIONS=20

# JWT & Authentication
JWT_SECRET=super_secret_jwt_key_must_be_at_least_32_characters_long_tari
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Account Vault Cryptographic Secret (Must be exactly 32-byte hex for AES-256-GCM)
# Generate with: openssl rand -hex 32
VAULT_MASTER_KEY=a7d2c94e81f5063b2c149d8e745f0132b98e4125c3498165b40d7e29f1234567

# Object Storage / S3 / MinIO
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=tari_minio_admin
STORAGE_SECRET_KEY=tari_minio_secret_password
STORAGE_BUCKET=tari-media
STORAGE_REGION=us-east-1

# CORS & Allowed Origins
CORS_ALLOWED_ORIGINS=https://tari.faridrhmn.my.id,http://tari.faridrhmn.my.id,http://localhost:5173

