# ========================================================
# TARI (Tata Organisasi) — Backend Environment Configuration
# ========================================================

# Server Configuration (Port 1999 sesuai kebutuhan deployment)
SERVER_HOST=0.0.0.0
SERVER_PORT=1999
ENVIRONMENT=production

# Database PostgreSQL
# Sesuaikan <user> dan <password> dengan konfigurasi PostgreSQL di server Anda
DATABASE_URL=postgres://postgres:password_kamu@localhost:5432/tari_db
DATABASE_MAX_CONNECTIONS=20

# JWT & Authentication Secret (minimal 32 karakter)
JWT_SECRET=rahasia_jwt_tari_super_aman_wajib_32_karakter_atau_lebih

# Durasi token aktif (jam)
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Master Key Enkripsi Akun Medsos / Vault (AES-256-GCM) - Tepat 64 karakter hex (32 bytes)
# Generate baru di terminal: openssl rand -hex 32
VAULT_MASTER_KEY=a7d2c94e81f5063b2c149d8e745f0132b98e4125c3498165b40d7e29f1234567

# Object Storage / MinIO (Opsional / Default)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=tari_admin
STORAGE_SECRET_KEY=tari_secret
STORAGE_BUCKET=tari-media
STORAGE_REGION=us-east-1

# Domain CORS yang diizinkan mengakses API
CORS_ALLOWED_ORIGINS=https://tari.faridrhmn.my.id,http://tari.faridrhmn.my.id,http://localhost:5173

