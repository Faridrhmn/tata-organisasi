[Unit]
Description=TARI (Tata Organisasi) Rust Axum API Service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Program/tata-organisasi/backend
EnvironmentFile=/home/ubuntu/Program/tata-organisasi/backend/.env
ExecStart=/home/ubuntu/Program/tata-organisasi/backend/target/release/tari-api

Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# Resource limits
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
