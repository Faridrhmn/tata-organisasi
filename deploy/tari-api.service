[Unit]
Description=TARI (Tata Organisasi) API Daemon
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=tari
Group=tari
WorkingDirectory=/opt/tari/current
EnvironmentFile=/opt/tari/shared/.env

ExecStart=/opt/tari/current/bin/tari-api

Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/tari/shared

# Resource limits
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target

